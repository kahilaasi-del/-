# פרטי חיבור ל-SQL Server של חשבשבת
# העתק קובץ זה ל-.env ומלא את הערכים. אל תעלה את .env ל-git!

# כתובת השרת. דוגמאות:
#   localhost\SQLEXPRESS
#   192.168.1.10
#   SERVERNAME\HASHAV
CHESHBSHEVET_SERVER=localhost\SQLEXPRESS

# שם מסד הנתונים של החברה בחשבשבת
CHESHBSHEVET_DATABASE=

# אימות: השאר ריק את USER/PASSWORD כדי להשתמש ב-Windows Authentication
CHESHBSHEVET_USER=
CHESHBSHEVET_PASSWORD=

# שם ה-ODBC Driver המותקן (17 או 18)
CHESHBSHEVET_DRIVER=ODBC Driver 17 for SQL Server

# עבור Driver 18 לרוב צריך:
#   TrustServerCertificate=yes
CHESHBSHEVET_TRUST_CERT=yes

# שנת/תקופת ברירת מחדל לניתוחים (אופציונלי)
DEFAULT_YEAR=2025
